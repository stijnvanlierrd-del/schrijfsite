# Kopieer naar .env.local voor lokaal gebruik. Zet deze waarden op Vercel als (sensitive) Environment Variables.
# Vul hier NOOIT echte sleutels in — dit bestand staat in Git.

# Neon Postgres connection string (pooled), bv. postgresql://user:pass@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Google Gemini API-sleutel voor de handschrift-analyse (alleen server-side gebruikt)
GEMINI_API_KEY=

# Optioneel: komma-gescheiden lijst modellen (eerste beschikbare wordt gebruikt)
# GEMINI_MODELS=gemini-3.5-flash,gemini-3.8-flash,gemini-flash-latest,gemini-3.1-flash-lite

# Optioneel: max. aantal AI-aanvragen per gebruiker per dag (standaard 40)
# AI_DAILY_LIMIT=40
