{
  "name": "schrijfsite",
  "version": "1.0.0",
  "private": true,
  "description": "Zet je eigen handschrift om in een alfabet en schrijf er elke tekst mee \u2014 op gelinieerd, blanco of ander papier.",
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/import-handschrift.mjs && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:migrate": "node scripts/migrate.mjs",
    "test": "node --test --experimental-strip-types tests/*.test.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "next": "^16.4.5",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^5.9.3"
  }
}